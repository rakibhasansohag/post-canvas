# Cloudflare Pages response headers. The home-screen icon and the search index have no file extension in the static
# export, so give them their type here. A JSON type also lets Cloudflare compress the index.
/apple-icon
  Content-Type: image/png
/api/search
  Content-Type: application/json; charset=utf-8

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/samples/*
  Cache-Control: public, max-age=604800
