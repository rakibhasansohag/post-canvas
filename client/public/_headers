# Cloudflare Pages response headers. The generated Open Graph image and the home-screen icon have no file extension
# in the static export, so give them their type here.
/opengraph-image
  Content-Type: image/png
/apple-icon
  Content-Type: image/png

/_next/static/*
  Cache-Control: public, max-age=31536000, immutable
/samples/*
  Cache-Control: public, max-age=604800
